<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.webgame.social.mapper.WgFriendshipMapper">

    <!-- 查询角色的好友列表 -->
    <select id="selectFriendsByCharacterId" resultType="org.jeecg.modules.webgame.social.entity.WgFriendship">
        SELECT * FROM wg_friendships
        WHERE character_id_1 = #{characterId} OR character_id_2 = #{characterId}
        ORDER BY created_at DESC
    </select>

</mapper>
