<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.webgame.social.mapper.WgChatUnreadMapper">

    <!-- 查询会话中角色的未读数 -->
    <select id="selectByConversationAndCharacter" resultType="org.jeecg.modules.webgame.social.entity.WgChatUnread">
        SELECT * FROM wg_chat_unread
        WHERE conversation_id = #{conversationId} AND character_id = #{characterId}
    </select>

</mapper>
